// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Microarea {
  id        Int        @id @default(autoincrement())
  nome      String     @unique
  descricao String?
  agentes   Agente[]
  pacientes Paciente[] @relation("PacienteToMicroarea")

  @@map("Microareas")
}

model Agente {
  id           Int        @id @default(autoincrement())
  nome         String
  email        String     @unique
  senha        String
  cargo        String?
  microarea_id Int?
  microarea    Microarea? @relation(fields: [microarea_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  tarefas      Tarefa[]
  pacientes    Paciente[]

  @@map("Agentes")
}

model Paciente {
  cpf          String     @id @db.Char(14)
  nome         String
  endereco     String?
  comorbidades String?
  situacao     String?
  agente_id    Int?
  agente       Agente?    @relation(fields: [agente_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  microarea_id Int?
  microarea    Microarea? @relation("PacienteToMicroarea", fields: [microarea_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  tarefas      Tarefa[]

  @@map("Pacientes")
}

model Tarefa {
  id             Int       @id @default(autoincrement())
  titulo         String
  descricao      String?
  status         String    @default("pendente")
  prioridade     String    @default("media")
  data_criacao   DateTime  @default(now())
  data_limite    DateTime?
  data_conclusao DateTime?
  tipo           String?
  agente_id      Int?
  agente         Agente?   @relation(fields: [agente_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  paciente_cpf   String?   @db.Char(14)
  paciente       Paciente? @relation(fields: [paciente_cpf], references: [cpf], onDelete: Cascade, onUpdate: Cascade)

  @@map("Tarefas")
}
